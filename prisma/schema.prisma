generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  username String  @unique
  password String
  order    Order[]
}

model Order {
  id           Int    @id @default(autoincrement())
  user         User   @relation(fields: [userId], references: [id])
  userId       String
  stock        Stock  @relation(fields: [stockId], references: [id])
  stockId      Int
  side         Side
  type         Type
  price        Int
  qty          Int
  filledQty    Int    @default(0)
  status       Status
  fillasBuyer  Fill[] @relation("BuyTrades")
  fillasSeller Fill[] @relation("SellTrades")
}

model Fill {
  id          Int      @id @default(autoincrement())
  stockId     Int
  price       Int
  qty         Int
  buyOrder    Order    @relation("BuyTrades", fields: [buyOrderId], references: [id])
  buyOrderId  Int
  SellOrder   Order    @relation("SellTrades", fields: [sellOrderId], references: [id])
  sellOrderId Int
  createdAt   DateTime @default(now())
}

model Stock {
  id     Int     @id @default(autoincrement())
  title  String
  symbol String  @unique
  slug   String  @unique
  orders Order[]
}

model Market {
  id       Int    @id @default(autoincrement())
  slug     String @unique
  imageUrl String
}

enum Side {
  BUY
  SELL
}

enum Status {
  OPEN
  PARTIAL
  FILLED
  CANCELLED
}

enum Type {
  LIMITED
  MARKET
}
